{
  "apiVersion": "v1",
  "kind": "PodList",
  "items": [
    {
      "metadata": {
        "name": "mooncake-rw-job-7b8f9",
        "namespace": "default",
        "labels": {
          "app": "mooncake-rw-job",
          "job-name": "mooncake-rw-job",
          "controller-uid": "8a2f1c4e-6d81-4b2a-9f3c-1e2d3b4a5c6d",
          "batch.kubernetes.io/job-name": "mooncake-rw-job",
          "clientless.fluid.io/inject": "true",
          "fluid.io/inject": "done"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "volumes": [
          {
            "name": "fluid-runtime-config-mooncake-demo",
            "configMap": {
              "name": "fluid-runtime-config-mooncake-demo"
            }
          }
        ],
        "containers": [
          {
            "name": "rw",
            "image": "fluidcloudnative/mooncake:e2e",
            "command": ["/bin/sh", "-ec"],
            "volumeMounts": [
              {
                "name": "fluid-runtime-config-mooncake-demo",
                "mountPath": "/etc/fluid/config/mooncake-demo",
                "readOnly": true
              }
            ],
            "env": [
              {
                "name": "POD_IP",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "status.podIP"
                  }
                }
              },
              {
                "name": "FLUID_RUNTIME_CONFIG_PATH_MOONCAKE_DEMO",
                "value": "/etc/fluid/config/mooncake-demo/runtime.sh"
              }
            ]
          }
        ]
      },
      "status": {
        "phase": "Succeeded"
      }
    }
  ]
}
